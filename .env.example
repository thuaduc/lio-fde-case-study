# Copy to .env (cp .env.example .env). docker compose reads it automatically.

# OpenAI: only needed for PDF extraction. The rest of the app runs without it.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Auth: signing secret for JWTs. Change it outside local development.
JWT_SECRET=dev-secret-change-in-production
