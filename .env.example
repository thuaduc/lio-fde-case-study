# Copy to .env (cp .env.example .env). docker compose reads it automatically.

# OpenAI: only needed for PDF extraction. The rest of the app runs without it.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-6.1-sol
# Sampling temperature for extraction. `none` omits the parameter entirely:
# gpt-6.1-sol rejects any temperature other than its default.
OPENAI_TEMPERATURE=none
# Embedding model for catalog suggestions (article/line similarity shortlist).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Auth: signing secret for JWTs. Change it outside local development.
JWT_SECRET=dev-secret-change-in-production
